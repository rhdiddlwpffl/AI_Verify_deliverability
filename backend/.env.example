# 이 파일은 "양식"입니다. 실제 값은 복사본인 backend/.env 에만 넣으세요. (.env는 git에서 제외됨)
# 복사: cp .env.example .env

# local | production
APP_ENV=local

# 프론트엔드 주소(CORS 허용). 여러 개면 쉼표로 구분
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL 연결 문자열 (4단계에서 채움)
# Supabase 대시보드 > 프로젝트 > 상단 'Connect' 에서 복사한다. 형태: postgresql://사용자:[비밀번호]@호스트:포트/postgres
# - [비밀번호] 자리에 DB 비밀번호를 넣는다. 비밀번호에 @ : / # ? 같은 특수문자가 있으면
#   URL 인코딩이 필요하다(예: @ -> %40). 헷갈리면 특수문자 없는 비밀번호로 재설정하는 편이 쉽다.
# - 따옴표 없이 한 줄로 쓴다.
DATABASE_URL=

# Claude API 키 (6단계에서 채움)
ANTHROPIC_API_KEY=
# 문장 분류에 쓰는 모델과 추론 강도(low | medium | high | xhigh | max). 비워 두면 기본값 사용
# EXTRACT_MODEL=claude-haiku-5-5   # 분류는 Haiku로 충분했다(평가: Sonnet과 동일, 약 19배 저렴). 근거 비교(JUDGE_MODEL)는 Sonnet 유지
# EXTRACT_EFFORT=low
# 근거 비교(발췌문이 주장을 뒷받침하는지) 호출의 모델과 추론 강도. 분석 1회 비용의 대부분이 여기서 나온다.
# (20문장 기준 Sonnet 5.5 약 $0.08~0.12, Haiku 5.5 약 $0.005 — 가격표 기준 추정치)
# JUDGE_MODEL=claude-sonnet-5-5
# JUDGE_EFFORT=medium
# 비교 호출 한 번에 담을 문장 수 / 동시에 보낼 비교 호출 수
# JUDGE_CHUNK_SIZE=8
# JUDGE_CONCURRENCY=2
# ---- 호출 횟수 제한 (분석 1회에 Claude 비용이 들기 때문에 남용을 막는다) ----
# 분석 1회 비용 실측: 5문장 약 $0.03, 20문장(최대) 약 $0.11 (가격표 기준 추정).
# 전체 24시간 한도 x $0.11 = 하루 비용의 최악 상한이다. (60회 -> 약 $6.6)
# RATE_LIMIT_IP_PER_MINUTE=3
# RATE_LIMIT_IP_PER_DAY=20
# RATE_LIMIT_GLOBAL_PER_DAY=60
# RATE_LIMIT_HISTORY_PER_MINUTE=60
# MAX_CONCURRENT_ANALYSES=3
# 앞단 프록시 개수. 로컬은 0, Render 배포는 1로 시작해 가짜 X-Forwarded-For로 우회되지 않는지 확인한다.
# 주의: 운영에서는 서버를 반드시 `uvicorn app.main:app --no-proxy-headers ...`로 실행한다.
#       (안 그러면 uvicorn이 헤더를 믿고 주소를 바꿔서, 헤더만 바꿔 호출 제한을 우회할 수 있다)
# TRUSTED_PROXY_COUNT=0
# IP를 해시할 때 섞는 비밀 값. APP_ENV=production이면 16자 이상으로 반드시 설정해야 서버가 시작된다.
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
# RATE_LIMIT_SALT=
# 저장된 분석 기록의 보관 일수. 저장할 때 이보다 오래된 기록을 함께 지운다. (0이면 자동 삭제 안 함)
# 프론트의 안내 문구(frontend/src/api/types.ts의 RETENTION_DAYS)와 같은 값으로 맞춘다.
# RETENTION_DAYS=30
# '내 기록' 목록에서 한 번에 가져올 최대 개수
# HISTORY_PAGE_SIZE=50
# 한 번의 분석에서 검색/비교할 최대 문장 수. 위키백과 한도(한 번에 약 10개)에 맞춘 값이고, 넘는 문장은
# '검증하지 못함'으로 표시한다. 취약점 신호가 많은 문장과 수치 주장을 먼저 고른다.
# MAX_VERIFY_CLAIMS=10
# 한 번에 분석할 최대 문장 수 (넘으면 오류로 알림)
# MAX_SENTENCES=60

# 검색 근거: 위키백과 API (키/카드 불필요)
# 위키미디어는 '설명이 담긴 User-Agent'를 요구하고, 없으면 IP가 차단될 수 있다.
# 로컬 개발은 기본값으로 충분하지만, 배포 전에는 연락처(URL 또는 이메일)를 넣는다.
# 예: SEARCH_USER_AGENT=AnswerAuditor/0.1 (https://github.com/<계정>/answer-auditor; you@example.com)
# SEARCH_USER_AGENT=
# 위키백과 요청 속도 조절. 실측(2026-11): 익명 요청은 한 번에 약 10개까지 허용되고 지속 속도는 약 0.4개/초이며,
# 넘으면 429와 Retry-After 21~47초가 온다. (걸린 채 계속 요청하면 대기 시간이 늘어난다)
# 서버의 모든 사용자가 같은 IP를 공유하므로 이 한도를 함께 나눠 쓴다. 연락처가 있는 User-Agent로 바꾸면 달라질 수 있어 배포 후 다시 측정한다.
# SEARCH_BURST=8
# SEARCH_REFILL_PER_SECOND=0.3
# SEARCH_MAX_WAIT_SECONDS=10
# SEARCH_CACHE_TTL_SECONDS=3600
# SEARCH_CACHE_MAX_ENTRIES=500
# SEARCH_PHASE_TIMEOUT=40
# 주장 하나당 가져올 검색 결과 수 / 결과마다 가져올 본문 글자 수 (늘리면 이후 비교 단계의 AI 비용이 늘어난다)
# SEARCH_RESULTS_PER_CLAIM=3
# SEARCH_EXTRACT_CHARS=400
