# 이 파일은 "양식"입니다. 실제 값은 복사본인 backend/.env 에만 넣으세요. (.env는 git에서 제외됨)
# 복사: cp .env.example .env

# local | production
APP_ENV=local

# 프론트엔드 주소(CORS 허용). 여러 개면 쉼표로 구분
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL 연결 문자열 (4단계에서 채움)
# Supabase 대시보드 > 프로젝트 > 상단 'Connect' 에서 복사한다. 형태: postgresql://사용자:[비밀번호]@호스트:포트/postgres
# - [비밀번호] 자리에 DB 비밀번호를 넣는다. 비밀번호에 @ : / # ? 같은 특수문자가 있으면
#   URL 인코딩이 필요하다(예: @ -> %40). 헷갈리면 특수문자 없는 비밀번호로 재설정하는 편이 쉽다.
# - 따옴표 없이 한 줄로 쓴다.
DATABASE_URL=

# Claude API 키 (6단계에서 채움)
ANTHROPIC_API_KEY=
# 문장 분류에 쓰는 모델과 추론 강도(low | medium | high | xhigh | max). 비워 두면 기본값 사용
# EXTRACT_MODEL=claude-sonnet-5-5
# EXTRACT_EFFORT=low
# 한 번에 분석할 최대 문장 수 (넘으면 오류로 알림)
# MAX_SENTENCES=60

# 검색 근거: 위키백과 API (키/카드 불필요)
# 위키미디어는 '설명이 담긴 User-Agent'를 요구하고, 없으면 IP가 차단될 수 있다.
# 로컬 개발은 기본값으로 충분하지만, 배포 전에는 연락처(URL 또는 이메일)를 넣는다.
# 예: SEARCH_USER_AGENT=AnswerAuditor/0.1 (https://github.com/<계정>/answer-auditor; you@example.com)
# SEARCH_USER_AGENT=
# 주장 하나당 가져올 검색 결과 수 / 결과마다 가져올 본문 글자 수 (늘리면 이후 비교 단계의 AI 비용이 늘어난다)
# SEARCH_RESULTS_PER_CLAIM=3
# SEARCH_EXTRACT_CHARS=400
